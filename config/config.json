{
    "description": "Offline learning for AgileX LIMO with robot-centric relative coordinates and discrete actions {-vmax, 0, +vmax} & {-wmax, 0, +wmax}",
    "dataset": {
        "schema": "robot_centric_5_columns",
        "columns": ["x_target_robot", "y_target_robot", "theta_robot", "v_robot", "w_robot"],
        "path": "data/dataset.csv",
        "x_max": 5.0,
        "y_max": 5.0,
        "step_xy": 0.5,
        "theta_range": [-3.141592653589793, 3.141592653589793]
    },
    "model": {
        "architecture": "PioneerNN",
        "input_size": 3,
        "hidden_size": 1000,
        "output_size": 2,
        "use_bias": false,
        "weights_path": "models/supervised_w_torch_diff.json",
        "history_path": "models/training_history.json"
    },
    "normalization": {
        "inputs": {
            "in_0": "x_target_robot / 5.0",
            "in_1": "y_target_robot / 5.0",
            "in_2": "theta_robot_absolute / pi"
        },
        "outputs_training": {
            "v_norm": "v_robot / 0.24 in {-1.0, 0.0, +1.0}",
            "w_norm": "w_robot / 0.50 in {-1.0, 0.0, +1.0}"
        },
        "outputs_robot_denormalization": {
            "v_cmd": "v_pred * 0.24",
            "w_cmd": "w_pred * 0.50"
        }
    },
    "kinematics": {
        "v_max": 0.24,
        "v_min": -0.24,
        "w_max": 0.50,
        "w_min": -0.50,
        "d_brake": 0.20,
        "d_stop": 0.05
    },
    "evaluation": {
        "output_dir": "data/evaluation/batch_run"
    }
}
